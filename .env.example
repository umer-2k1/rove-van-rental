# Pooled connection string used by the app at runtime.
# Neon: use the "-pooler" host. Any Postgres with SSL also works.
DATABASE_URL="postgresql://user:password@host-pooler/db?sslmode=verify-full"

# Direct (non-pooled) connection, used by `prisma migrate`.
# Neon: the same host without "-pooler".
DIRECT_URL="postgresql://user:password@host/db?sslmode=verify-full"

# Admin dashboard password
ADMIN_PASSWORD="change-me"

# Secret used to sign the admin session cookie (32+ random characters)
SESSION_SECRET="change-me-to-a-long-random-string"
